<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmartLock.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- In-process broker used only by the integration tests. -->
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartLock.Backend\SmartLock.Backend.csproj" />
    <ProjectReference Include="..\SmartLock.Device\SmartLock.Device.csproj" />
    <ProjectReference Include="..\SmartLock.Contracts\SmartLock.Contracts.csproj" />
  </ItemGroup>

</Project>
